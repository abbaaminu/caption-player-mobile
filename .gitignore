app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing material must never be committed
android/key.properties
android/app/*.jks
android/app/*.keystore
*.jks
/live-caption-release-key.jks

# Vosk's iOS XCFramework is downloaded by `dart run vosk_flutter_service install -t ios`
third_party/vosk_flutter_service/ios/vosk_flutter_service/Frameworks/
