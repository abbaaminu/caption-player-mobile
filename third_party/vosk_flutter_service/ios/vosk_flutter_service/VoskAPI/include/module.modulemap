// Custom module map for the `VoskAPI` Clang target.
//
// SwiftPM uses a module.modulemap found in `publicHeadersPath` as-is (it only
// generates one when this file is absent), which lets us attach the autolink
// directives below to it.
//
// `link` directives are recorded by Clang/Swift in every object file that
// imports this module (LC_LINKER_OPTION). That is what guarantees the Runner
// target links libc++ and Accelerate, because libvosk.a is reached through a
// statically linked Swift package product and therefore cannot rely on the
// podspec (CocoaPods is not used when the plugin is built with SwiftPM).
module VoskAPI [system] {
    header "vosk_api.h"
    export *
    link "c++"
    link framework "Accelerate"
}
